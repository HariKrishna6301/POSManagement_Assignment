<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>POS Management</title>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<style>
body{background:#f5f7fb}.sidebar{min-height:100vh;background:#172033}.sidebar a{color:#dbe3f0;text-decoration:none;display:block;padding:12px 18px}.sidebar a:hover{background:#26344f}.card{border:0;box-shadow:0 2px 12px #00000010}.brand{font-weight:700;font-size:20px;padding:20px;color:white}
</style>
</head>
<body>
<div class="d-flex">
<aside class="sidebar" style="width:240px">
<div class="brand">POS Management</div>
<a asp-controller="Dashboard" asp-action="Index">Dashboard</a>
<a asp-controller="Products" asp-action="Index">Products / Inventory</a>
<a asp-controller="POS" asp-action="Index">POS Billing</a>
<a asp-controller="Orders" asp-action="Index">Order History</a>
<a asp-controller="Orders" asp-action="DailyReport">Daily Report</a>
</aside>
<main class="flex-grow-1 p-4">
@if(TempData["Success"] != null){<div class="alert alert-success">@TempData["Success"]</div>}
@RenderBody()
</main>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>

@model IEnumerable<ProductDto>
<h2>POS Billing</h2>
<div class="row g-4">
<div class="col-lg-7">
<div class="card p-3">
<form class="row g-2 mb-3"><div class="col"><input name="search" class="form-control" placeholder="Search product name / SKU"/></div><div class="col-auto"><button class="btn btn-primary">Search</button></div></form>
<div class="row g-2">
@foreach(var p in Model){
<div class="col-md-6"><div class="border rounded p-3 bg-white"><b>@p.Name</b><div class="text-muted">@p.SKU</div><div>₹@p.Price.ToString("N2") | Stock: @p.StockQuantity</div>
<button class="btn btn-sm btn-success mt-2" onclick="addItem(@p.ProductId,'@p.Name.Replace("'","\\'")',@p.Price,@p.StockQuantity);return false;">Add</button></div></div>
}
</div></div></div>
<div class="col-lg-5"><div class="card p-3"><h5>Cart</h5><div id="cart"></div>
<div class="mt-3"><label>Discount</label><input id="discount" type="number" step="0.01" value="0" class="form-control"></div>
<div class="mt-2"><label>GST %</label><input id="gst" type="number" step="0.01" value="18" class="form-control"></div>
<hr><div>Subtotal: ₹<span id="subtotal">0.00</span></div><div>Discount: ₹<span id="discountTotal">0.00</span></div><div>Tax: ₹<span id="tax">0.00</span></div><h4>Grand Total: ₹<span id="grand">0.00</span></h4>
<button class="btn btn-primary w-100" onclick="completeSale();return false;">Complete Sale</button></div></div>
</div>
@section Scripts {
<script>
let cart=[];
function addItem(id,name,price,stock){let x=cart.find(a=>a.productId===id);if(x){if(x.quantity<stock)x.quantity++;}else cart.push({productId:id,productName:name,unitPrice:price,quantity:1,stock:stock});render();}
function removeItem(id){cart=cart.filter(x=>x.productId!==id);render();}
function changeQty(id,v){let x=cart.find(a=>a.productId===id);if(x)x.quantity=Math.max(1,Math.min(x.stock,parseInt(v)||1));render();}
function render(){let h='';cart.forEach(x=>h+=`<div class="border-bottom py-2"><b>${x.productName}</b><div class="d-flex gap-2 mt-1"><input class="form-control form-control-sm" style="width:80px" type="number" value="${x.quantity}" min="1" max="${x.stock}" onchange="changeQty(${x.productId},this.value)"><span class="pt-1">₹${(x.quantity*x.unitPrice).toFixed(2)}</span><button class="btn btn-sm btn-outline-danger" onclick="removeItem(${x.productId})">×</button></div></div>`);document.getElementById('cart').innerHTML=h||'<div class="text-muted">Cart is empty</div>';let sub=cart.reduce((s,x)=>s+x.quantity*x.unitPrice,0);let dis=Math.min(sub,parseFloat(document.getElementById('discount').value)||0);let tax=(sub-dis)*(parseFloat(document.getElementById('gst').value)||0)/100;document.getElementById('subtotal').textContent=sub.toFixed(2);document.getElementById('discountTotal').textContent=dis.toFixed(2);document.getElementById('tax').textContent=tax.toFixed(2);document.getElementById('grand').textContent=(sub-dis+tax).toFixed(2);}
document.getElementById('discount').addEventListener('input',render);document.getElementById('gst').addEventListener('input',render);
async function completeSale(){if(!cart.length){alert('Cart is empty');return;}let sub=cart.reduce((s,x)=>s+x.quantity*x.unitPrice,0),dis=Math.min(sub,parseFloat(document.getElementById('discount').value)||0),tax=(sub-dis)*(parseFloat(document.getElementById('gst').value)||0)/100;let dto={orderNumber:'ORD-'+Date.now(),subtotal:sub,discount:dis,tax:tax,grandTotal:sub-dis+tax,items:cart.map(x=>({productId:x.productId,productName:x.productName,quantity:x.quantity,unitPrice:x.unitPrice,lineTotal:x.quantity*x.unitPrice}))};let r=await fetch('/POS/Complete',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(dto)});let d=await r.json();if(d.success){alert('Order created: '+d.orderNumber+'\\nNow trigger the payment webhook to mark it Paid.');cart=[];render();}else alert(d.message||'Error');}
render();
</script>
}
